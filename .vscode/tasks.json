{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: web dev",
      "type": "shell",
      "command": "pnpm -C artifacts/web run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "backend: api-server dev",
      "type": "shell",
      "command": "pnpm -C artifacts/api-server run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "full stack: run app",
      "dependsOn": [
        "frontend: web dev",
        "backend: api-server dev"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
